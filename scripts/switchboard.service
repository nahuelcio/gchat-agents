# Keeps the bridge alive: systemd restarts it whenever it exits or crashes.
# Install (user service, no root):
#   cargo build --release --manifest-path rust/Cargo.toml
#   mkdir -p ~/.config/systemd/user
#   sed -e "s|@DIR@|$PWD|g" -e "s|@BIN@|$PWD/rust/target/release/switchboard|g" scripts/switchboard.service > ~/.config/systemd/user/switchboard.service
#   systemctl --user daemon-reload && systemctl --user enable --now switchboard
#   loginctl enable-linger "$USER"   # keep running after logout
# Logs: journalctl --user -u switchboard -f
[Unit]
Description=Switchboard bridge and control plane
After=network-online.target

[Service]
WorkingDirectory=@DIR@
EnvironmentFile=-@DIR@/.env
ExecStart=@BIN@
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/.cargo/bin
Environment=SWITCHBOARD_SUPERVISED=systemd
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=default.target
