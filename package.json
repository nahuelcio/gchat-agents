{
  "name": "switchboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Google Chat bridge for local coding agents, with a local control plane",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run -s build:web && cargo run --manifest-path rust/Cargo.toml --release",
    "dev": "node scripts/dev.mjs",
    "dev:echo": "node scripts/dev.mjs --driver echo",
    "start:dev": "npm run -s dev",
    "build": "npm run -s build:web && cargo build --manifest-path rust/Cargo.toml --release",
    "build:web": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "build:rust": "cargo build --manifest-path rust/Cargo.toml --release",
    "dev:web": "vite --config web/vite.config.ts",
    "test": "cargo test --manifest-path rust/Cargo.toml",
    "test:web": "vitest run",
    "e2e": "cargo build --manifest-path rust/Cargo.toml && node scripts/e2e-rust.mjs",
    "test:browser": "npm run -s build:web && cargo build --manifest-path rust/Cargo.toml && e2e run",
    "smoke": "cargo run --manifest-path rust/Cargo.toml -- --driver echo"
  },
  "dependencies": {
    "google-auth-library": "^11.2.0"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.15.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "e2e": "^0.21.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
