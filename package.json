{
  "name": "gchat-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Google Chat bridge for local coding agents, with a local control plane",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run -s build && node --env-file-if-exists=.env dist/src/index.js",
    "build": "tsc -p tsconfig.json && npm run -s build:web",
    "build:web": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "test": "vitest run",
    "smoke": "tsc -p tsconfig.json && node dist/scripts/smoke.js"
  },
  "dependencies": {
    "google-auth-library": "^11.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
