{
  "name": "switchboard",
  "version": "0.6.2",
  "private": true,
  "description": "Google Chat bridge for local coding agents, with a local control plane",
  "type": "module",
  "scripts": {
    "start": "npm run -s build:web && cargo run --manifest-path rust/Cargo.toml --release",
    "dev": "node scripts/dev.mjs",
    "dev:echo": "node scripts/dev.mjs --driver echo",
    "start:dev": "npm run -s dev",
    "build": "npm run -s build:web && cargo build --manifest-path rust/Cargo.toml --release",
    "build:web": "tsc -p web/tsconfig.json && vp build --config web/vite.config.ts",
    "build:rust": "cargo build --manifest-path rust/Cargo.toml --release",
    "dev:web": "vp dev --config web/vite.config.ts",
    "test": "cargo test --manifest-path rust/Cargo.toml",
    "test:web": "vp test run",
    "e2e": "cargo build --manifest-path rust/Cargo.toml && node scripts/e2e-rust.mjs",
    "test:browser": "npm run -s build:web && cargo build --manifest-path rust/Cargo.toml && e2e run",
    "smoke": "cargo run --manifest-path rust/Cargo.toml -- --driver echo"
  },
  "dependencies": {
    "@cioffinahuel/opencode-ado": "^0.9.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-codemode": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "pele": "^1.6.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typebox": "1.3.27",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.15.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "e2e": "^0.21.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
