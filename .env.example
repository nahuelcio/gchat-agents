# Switchboard — copy to .env. Only the first key is required.
# Everything else (agent, models, repos, spaces) lives in the control plane:
# http://127.0.0.1:8081 after `npm start`.

# Service account key used to post replies (chat.bot scope): file path or base64 JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional ------------------------------------------------------------------

# opentunnel is on by default; the Chat endpoint and token audience come from it.
# TUNNEL=off                        # disable tunnel, use your own public endpoint
# GOOGLE_TOKEN_AUDIENCE=https://your-host/google/chat   # required only with TUNNEL=off

# PORT=8080                    # bridge (public via tunnel)
# ADMIN_PORT=8081              # control plane, loopback only
# AGENT_WORKDIR=./data/workspace
# AGENT_TURN_TIMEOUT_MS=600000
# DATA_DIR=./data
