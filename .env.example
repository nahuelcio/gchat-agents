# gchat-agents configuration
# Copy to .env and fill in. Every key below maps to src/config.ts.

# Port for the HTTP server (POST /google/chat, GET /healthz).
PORT=8080

# What Google Chat puts in the bearer token's audience claim. Pick ONE mode:
#   - If the Chat app connection setting is "HTTP endpoint URL": the public
#     URL you registered, e.g. https://chat-agents.example.com/google/chat
#   - If it is "Project Number": the Cloud project number, e.g. 1234567890
GOOGLE_TOKEN_AUDIENCE=

# Service account credentials used to POST replies to the Chat API
# (scope https://www.googleapis.com/auth/chat.bot).
# Either a file path or the full JSON key as base64.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Space allowlist. Events from any other space are dropped without running
# the agent. Get the id with: curl (or the Chat API) spaces.list
# Example: spaces/AAAA,spaces/BBBB
CHAT_ALLOWED_SPACES=

# Directory the agent works in. Use a DEDICATED directory: the agent can
# read and modify files here. Defaults to the process working directory.
AGENT_WORKDIR=/home/you/agent-workspace

# opencode binary. Override if not on PATH.
OPENCODE_BIN=opencode

# Optional model override for opencode, "provider/model#variant".
# OPENCODE_MODEL=anthropic/claude-sonnet-4-5

# Which agent runtime to drive: "opencode" (default) or "claude".
AGENT_DRIVER=opencode

# Claude Code binary (used when AGENT_DRIVER=claude) and optional model.
CLAUDE_BIN=claude
# CLAUDE_MODEL=claude-sonnet-4-5

# Max wall time for one agent turn (ms). On timeout the whole opencode
# process group is killed and an error is posted to the thread.
AGENT_TURN_TIMEOUT_MS=600000

# Where the thread -> session map is persisted (sessions.json).
DATA_DIR=./data
